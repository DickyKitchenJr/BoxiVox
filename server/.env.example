# Environment variables example file for reference. Copy this file to .env and replace the examples with values for your environment.
MONGODB_URI=mongodb://your_mongodb_uri_here (for example, use either your private machine's LAN address like mongodb://192.168.1.25:27017/boxivox or your MongoDB Atlas connection string)
PORT=your_port_here (for example, 5000)
NODE_ENV=your_node_environment_here (for example, development or production)
CLIENT_ORIGIN=your_client_url_here (for example, http://localhost:5173)
SESSION_SECRET=your_session_secret_here (for example, 32 random characters)
